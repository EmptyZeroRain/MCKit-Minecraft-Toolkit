# 复制本文件为 .env 并按需修改真实值；.env 不得提交版本控制。
APP_ENV=development
APP_ADDR=:8080
APP_BASE_URL=http://localhost:5173
DATABASE_URL=postgres://mc_user:change_me@localhost:5432/mc_tools?sslmode=disable
# 启动时自动应用未执行的数据库迁移（默认 true）；多实例并发启动由 advisory lock 串行化
AUTO_MIGRATE=true
# 迁移目录（相对进程工作目录；Docker 镜像内为 migrations）
MIGRATIONS_DIR=migrations
SESSION_SECRET=replace_with_random_secret
# 统一会话 Cookie 名：管理员与普通用户共用（迁移 0022 后不再有独立用户 Cookie）
SESSION_COOKIE_NAME=mc_session
SESSION_SECURE_COOKIE=false
# 会话存储：memory（单实例，进程重启后会话失效）| postgres（多实例共享，会话跨实例一致）
# 多实例部署必须使用 postgres，否则各实例登录状态互不相通。详见 docs/部署与会话方案.md
SESSION_STORE=memory
# 会话绝对有效期（小时）：任何续期都不能越过该上限
SESSION_TTL_HOURS=72
# 会话空闲超时（分钟）：0 表示不启用；生产建议 120
SESSION_IDLE_MINUTES=0
# 统一密码策略：后台账号 / 普通用户的最小长度（后台权限更高，要求更长）
PASSWORD_MIN_LENGTH_ADMIN=12
PASSWORD_MIN_LENGTH_USER=8
PASSWORD_MAX_LENGTH=128
# 双因子认证（TOTP）密钥：AES-GCM 加密 MFA secret，需 16/24/32 字节的 base64 或 hex。
# 留空表示不部署 MFA（此时已绑定 MFA 的账号会被拒绝登录，需管理员先执行「重置 MFA」）。
# 生成示例：openssl rand -base64 32
# 注意：更换密钥会导致所有已绑定账号的 secret 无法解密，必须提前安排重新绑定。
MFA_ENCRYPTION_KEY=
# 认证器 App 中展示的服务名
MFA_ISSUER=MC 工具站
# CSRF 豁免来源（逗号分隔）：仅用于确有需要的第三方回调，默认为空
CSRF_EXEMPT_ORIGINS=
# 注册图形验证码（迁移 0026 起注册需填昵称、邮箱与验证码）
# CAPTCHA_ENABLED=false 可关闭验证码校验（注册将不再要求验证码）
CAPTCHA_ENABLED=true
CAPTCHA_TTL_SECONDS=300
# CAPTCHA_FIXED_CODE：固定验证码，仅用于自动化测试；生产必须留空（APP_ENV=production 时设置将拒绝启动）
CAPTCHA_FIXED_CODE=
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=debug
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
# /mc/seeds/find 单独限流（该接口单次限时 5s；设为 0 可禁用）
MC_FIND_RPS=1
MC_FIND_BURST=2
# /mc/structures 与 /mc/slime-chunks 等遍历型接口单独限流 + 并发上限（单次限时 3s；设为 0 可禁用）
MC_HEAVY_RPS=3
MC_HEAVY_BURST=6
MC_HEAVY_CONCURRENCY=2
LINK_CHECK_TIMEOUT_SECONDS=8
LINK_CHECK_MAX_REDIRECTS=3
# 批量链接检查的并发上限（1–16，超出按 16 截断）
LINK_CHECK_MAX_CONCURRENCY=4
# MC 版本元数据（Mojang API）磁盘缓存
MCMETA_CACHE_DIR=cache
MCMETA_CACHE_TTL_HOURS=168
# 物品 ID 对照表源文件（相对 backend 运行目录）
BLOCK_ID_FILE=data/物品id.md
# MC 源码浏览器（mcsrc）：jar 缓存目录、单 jar 体积上限（MB）、类索引上限（超出则截断）
MCSRC_ENABLED=true
MCSRC_CACHE_DIR=cache/mcsrc
MCSRC_JAR_MAX_MB=512
MCSRC_INDEX_MAX_CLASSES=60000
# 匿名访客自动准备的版本数上限（前端选中版本即自动下载 + 建索引）；
# 达到上限后匿名访客不再自动下载（需管理员准备），0 表示关闭自动准备。
# 具备 ops.mcsrc 权限的管理员不受此限制。
MCSRC_AUTO_PREPARE_MAX=12
# 源码缓存容量告警阈值（MB，默认 4096）：占用达到阈值后，
# 「运营告警」会产生 mcsrc.capacity 告警，提醒清理不再需要的版本。
MCSRC_CACHE_ALERT_MB=4096
# 区块文件 region_token 内存缓存上限与有效期（仅内存、不落盘）
REGION_CACHE_MAX_MB=256
REGION_CACHE_TTL_SECONDS=600
# data 导入执行者标识（记录到 data_import_jobs.operator；留空则取系统用户名）
IMPORT_OPERATOR=
# 使用统计与运营看板（TODO §13）：是否启用采集、落库周期、日聚合保留天数（含当天，<=0 表示不清理）
STATS_ENABLED=true
STATS_FLUSH_SECONDS=60
STATS_RETENTION_DAYS=180
# 审计日志保留天数（默认 180；<=0 表示不清理，审计表只增不减）
AUDIT_RETENTION_DAYS=180
# 后台任务（admin_jobs）保留天数（默认 90）：只清理已结束（成功/失败/取消）的任务，
# 排队与执行中的任务永不清理；<=0 表示不清理。
JOB_RETENTION_DAYS=90
# 用户成长系统业务时区（IANA 名称，默认 Asia/Shanghai）：
# 每日任务按该时区划分业务日期（(user_id, task_code, task_date) 唯一），非法值回退默认时区。
GROWTH_TIMEZONE=Asia/Shanghai
